# =============================================================
# Environment variables for the Space Engineers Ore & POI Registry
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
# =============================================================

# ----- Supabase ----------------------------------------------
# Project Settings -> API Keys in the Supabase dashboard.
# Uses the new publishable/secret key system (replaces legacy anon/service_role).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Publishable key (sb_publishable_...) — safe in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Secret key (sb_secret_...) — SERVER ONLY. Never expose to the browser or put
# it behind a NEXT_PUBLIC_ prefix. Used for admin/server-side actions that
# bypass row-level security. (Supabase also blocks it from running in browsers.)
SUPABASE_SECRET_KEY=sb_secret_your-key

# ----- Cloudflare Turnstile ----------------------------------
# Cloudflare dashboard -> Turnstile -> add a widget.
# Site key is public (used in the browser); secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
