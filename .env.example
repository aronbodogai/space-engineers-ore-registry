# =============================================================
# Environment variables for the Space Engineers Ore & POI Registry
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local — it is gitignored.
# =============================================================

# ----- Supabase ----------------------------------------------
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — SERVER ONLY. Never expose to the browser.
# Used for admin/server-side actions that must bypass row-level security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ----- Cloudflare Turnstile ----------------------------------
# Cloudflare dashboard -> Turnstile -> add a widget.
# Site key is public (used in the browser); secret key is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
